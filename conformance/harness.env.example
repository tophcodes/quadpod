# The environment the Solid conformance-test-harness reads.
#
# `run.sh` generates the real thing at `conformance/.run/harness.env` on every
# run — the client credentials are minted fresh against a throwaway CSS, so
# there is nothing here to fill in by hand and nothing to keep. This file
# exists to document what the generated file contains and why each key is set
# the way it is. Keys and their meanings come from the harness's own
# `Config.java` / `UserCredentials.java`.

# --- identity -----------------------------------------------------------
# The IdP. This pod is verify-only: it never issues a token, so the harness
# must get its credentials somewhere else. `run.sh` starts a Community Solid
# Server purely for this. Any Solid-OIDC IdP advertising `client_credentials`
# in `grant_types_supported` would do.
SOLID_IDENTITY_PROVIDER=http://localhost:3001/

# The two test users. Both WebID documents are dereferenced twice: by the
# harness (`AuthManager.checkWebId`) and by the pod (`HttpWebIdIssuers`, to
# confirm the document names the token's `iss` via `solid:oidcIssuer`).
# CSS mints these paths when `createCredentials.js` creates the pods.
USERS_ALICE_WEBID=http://localhost:3001/alice/profile/card#me
USERS_BOB_WEBID=http://localhost:3001/bob/profile/card#me

# Client credentials, minted by `createCredentials.js`. The harness picks the
# client-credentials flow because these two are set and no username/password
# or refresh token is. Left blank here: they are per-run secrets.
USERS_ALICE_CLIENTID=
USERS_ALICE_CLIENTSECRET=
USERS_BOB_CLIENTID=
USERS_BOB_CLIENTSECRET=

# --- the server under test ----------------------------------------------
# Absolute on purpose. An absolute TEST_CONTAINER makes the harness skip
# `findStorage()`, which would otherwise require `pim:storage` in Alice's
# WebID document and a `rel="type"` `pim:Storage` link on the pod root —
# neither of which exists here. It must also be byte-identical to the pod's
# `--base-uri`, or every DPoP `htu` comparison fails and every request 401s.
TEST_CONTAINER=http://localhost:3000/

# --- not set, deliberately ----------------------------------------------
# RESOURCE_SERVER_ROOT      — only needed when TEST_CONTAINER is relative.
# USER_REGISTRATION_ENDPOINT / LOGIN_ENDPOINT — CSS-specific flows the
#                             client-credentials path does not use.
# ALLOW_SELF_SIGNED_CERTS   — everything here is plain http on loopback.
